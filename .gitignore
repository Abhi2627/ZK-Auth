# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Prisma
prisma/migrations/**/migration_lock.toml

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
*.egg-info/
dist/
.pytest_cache/

# Stray virtualenvs from malformed `python -m venv <arg>` commands.
# These are accidental dirs that only ever contain bin/include/lib + pyvenv.cfg.
# (\# is escaped because a bare # starts a comment in .gitignore)
ml-service/\#/
ml-service/adjust/
ml-service/different/
ml-service/if/
ml-service/path/
pyvenv.cfg

# ML model artifacts (large binaries — use DVC or separate storage)
ml-service/models/**/*.keras
ml-service/models/**/*.h5
ml-service/models/**/*.pkl
!ml-service/models/.gitkeep

# ZKP artifacts
# NOTE: zkey/wasm/r1cs ARE committed for this project (unlike most ZKP repos)
# because friends/collaborators benchmarking this system need to run the
# REAL compiled circuit + REAL proving key without redoing trusted setup —
# regenerating a zkey produces a DIFFERENT, incompatible proving key since
# the setup ceremony involves fresh randomness. Only *.wtns (per-run witness
# files, regenerated every proof, never needed by anyone else) stay ignored.
backend/circuits/**/*.wtns

# gRPC generated stubs
backend/src/grpc/generated/
ml-service/proto/*_pb2*.py
ml-service/proto/*_pb2*.pyi

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino-*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.pub-cache/

# Certs (never commit TLS certs)
certs/
*.pem
*.crt
*.key
!certs/.gitkeep
