# ─── ZK-Auth Backend — LOCAL Development Template ────────────────────────────
#
# COPY THIS FILE, don't edit it in place:
#   cp backend/.env.local.example backend/.env.local
#
# This is the file `npm run dev` / `./start.sh` actually loads (via
# `tsx watch --env-file=.env.local`) — NOT `backend/.env` (that one is only
# read by Docker Compose for container env, and is unused when you run the
# backend natively with `npm run dev`).
#
# All values below are safe placeholders for local development — there are
# no real secrets in this file. You do not need to change anything to get
# the benchmark running; these defaults work out of the box with the
# Docker Compose infra (`./start.sh` starts Postgres/TimescaleDB/Redis on
# these exact ports/passwords).

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zkauth_root:changeme_dev@localhost:5432/zkauth_db

# ─── TimescaleDB ──────────────────────────────────────────────────────────────
TIMESCALE_URL=postgresql://zkauth_root:changeme_dev@localhost:5433/zkauth_telemetry

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme_dev
REDIS_KEY_PREFIX=zkauth

# ─── JWT (dev only — fine to leave as-is, these are not used in production) ──
JWT_ACCESS_SECRET=dev_access_secret_32bytes_minimum_length_x
JWT_REFRESH_SECRET=dev_refresh_secret_32bytes_minimum_length_x
JWT_ISSUER=zk-auth-dev
JWT_AUDIENCE=zk-auth-clients
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── ZKP Circuits ─────────────────────────────────────────────────────────────
# These paths must point to real compiled circuit artifacts. They are
# committed to the repo (see backend/circuits/auth/) — no need to compile
# anything yourself for benchmarking purposes.
AUTH_CIRCUIT_VKEY_PATH=./circuits/auth/verification_key.json
DISCLOSURE_CIRCUIT_VKEY_PATH=./circuits/disclosure/verification_key.json

# ─── ML gRPC ──────────────────────────────────────────────────────────────────
# The ML service is SOFT/OPTIONAL for benchmarking purposes — there's a
# circuit breaker fallback if it's not running (see GRPC_CIRCUIT_* below),
# so you do not need to start ml-service just to run the ZKP login
# benchmark. Only needed if you want to exercise the behavioral-risk /
# step-up flow specifically.
LSTM_GRPC_HOST=localhost
LSTM_GRPC_PORT=50051
LSTM_GRPC_INSECURE=true

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Risk ─────────────────────────────────────────────────────────────────────
RISK_THRESHOLD_MEDIUM=0.45
RISK_THRESHOLD_HIGH=0.75
RISK_THRESHOLD_CRITICAL=0.90
RISK_STEP_UP_SOFT_THRESHOLD=0.75
RISK_STEP_UP_HARD_THRESHOLD=0.90

# ─── Session ──────────────────────────────────────────────────────────────────
WS_PING_INTERVAL_MS=30000
STEP_UP_TTL_SECONDS=300
CHALLENGE_TTL_SECONDS=120
NULLIFIER_LOCK_TTL_SECONDS=5

# ─── Recovery ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# ─── Circuit breaker ──────────────────────────────────────────────────────────
GRPC_TIMEOUT_MS=5000
GRPC_CIRCUIT_OPEN_THRESHOLD=5
GRPC_CIRCUIT_RESET_MS=30000

# ─── Issuer ───────────────────────────────────────────────────────────────────
ISSUER_SECRET_TOKEN=dev_issuer_secret_token_minimum_32_chars_x

# ─── Institute Ed25519 Private Key (not needed for the benchmark) ────────────
# ISSUER_PRIVATE_KEY_HEX=<paste_your_64_char_hex_private_key_here>

# ─── ZKP Dev bypass ───────────────────────────────────────────────────────────
# MUST stay false — this is what makes the benchmark measure REAL Groth16
# proof generation + verification instead of a bypassed mock path.
SKIP_ZKP_VERIFY_DEV=false

# ─── Rate limits ──────────────────────────────────────────────────────────────
# Pre-raised above the production defaults (10/20) so that running 60+
# benchmark trials back-to-back doesn't trip rate limiting and pollute
# your results with challenge_failed_429 errors. If you restore these to
# 10/20 for any other testing, remember the backend must be RESTARTED for
# the change to take effect — it reads this file once at boot, not live.
RATE_LIMIT_CHALLENGE_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=600
HOST=0.0.0.0
